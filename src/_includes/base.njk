    <!-- Telegram Widget Styles -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Функция для изменения стилей виджета Telegram
        function styleTelegramWidget() {
          var container = document.querySelector('.telegram-widget-container');
          if (container) {
            // Найти iframe внутри контейнера
            var iframe = container.querySelector('iframe');
            if (iframe) {
              // Добавить класс для стилизации
              iframe.classList.add('styled-telegram-widget');
            }
          }
        }
        
        // Попробовать применить стили сразу и через небольшую задержку
        styleTelegramWidget();
        setTimeout(styleTelegramWidget, 1000);
      });
    </script>
